# POCKET OPTION CREDENTIALS
# Never commit real credentials - use environment variables only
POCKET_OPTION_SSID=your_session_id_here
POCKET_OPTION_UID=your_uid_here

# WEBSOCKET CONFIGURATION
# Demo or Real
POCKET_OPTION_MODE=demo
POCKET_OPTION_DEMO_URL=wss://demo-api-eu.po.market/socket.io/?EIO=4&transport=websocket
POCKET_OPTION_REAL_URL=wss://api-eu.po.market/socket.io/?EIO=4&transport=websocket

# BOT CONFIGURATION
SIGNAL_BOT_PORT=3000
SIGNAL_BOT_HOST=localhost
LOG_LEVEL=info
MARKET_MONITORING_INTERVAL=1000
SIGNAL_COOLDOWN_MS=5000

# TRADING SETTINGS
DEFAULT_ASSET=XAUUSD_otc
DEFAULT_TIMEFRAME=60
MIN_CANDLES_REQUIRED=20
SUPPORT_RESISTANCE_LOOKBACK=50

# STRATEGY SETTINGS
ENABLE_BULLISH_PATTERNS=true
ENABLE_BEARISH_PATTERNS=true
ENABLE_MARKET_STRUCTURE=true
MIN_SIGNAL_CONFIDENCE=medium
